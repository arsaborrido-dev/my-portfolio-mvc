@model my_portfolio_mvc.ViewModels.Project.ProjectViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Add Project</h1>

<h4>ProjectViewModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AddProject">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Title" class="control-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ShortDescription" class="control-label"></label>
                <input asp-for="ShortDescription" class="form-control" />
                <span asp-validation-for="ShortDescription" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LongDescription" class="control-label"></label>
                <input asp-for="LongDescription" class="form-control" />
                <span asp-validation-for="LongDescription" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ProjectDemonstration" class="control-label"></label>
                <input asp-for="ProjectDemonstration" class="form-control" />
                <span asp-validation-for="ProjectDemonstration" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ThumbnailImageUrl" class="control-label"></label>
                <input asp-for="ThumbnailImageUrl" class="form-control" />
                <span asp-validation-for="ThumbnailImageUrl" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="GithubUrl" class="control-label"></label>
                <input asp-for="GithubUrl" class="form-control" />
                <span asp-validation-for="GithubUrl" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="LiveDemoUrl" class="control-label"></label>
                <input asp-for="LiveDemoUrl" class="form-control" />
                <span asp-validation-for="LiveDemoUrl" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="IsFeatured" class="control-label"></label>
                <input asp-for="IsFeatured" class="form-check-input" />
                <span asp-validation-for="IsFeatured" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
