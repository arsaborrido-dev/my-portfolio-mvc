
@using my_portfolio_mvc.ViewModels.Admin;

@model AdminViewModel

@{
    ViewData["Title"] = "Admin";
}

<section class="projects-list-page py-5 py-lg-6">
    <div class="container">
        <p>
            <a asp-action="AddProject">Add New Project</a>
        </p>

        <div class="projects-list">
            <table class="table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Creation Date</th>         
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model?.Projects != null && Model.Projects.Any())
                    {
                        foreach (var proj in Model.Projects)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => proj.Title)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => proj.ShortDescription)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => proj.CreatedAtUtc)
                                </td>
                                <td>
                                    <a asp-action="EditProject" asp-route-id="@proj.Id">Edit</a> |
                                    <a asp-controller="Project" asp-action="ProjectDetail" asp-route-id="@proj.Id" class="text-decoration-none">Details</a> |
                                    <form asp-action="DeleteProject"
                                          asp-route-id="@proj.Id"
                                          method="post"
                                          style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
            
                </tbody>
            </table>
        </div>
    
    </div>
</section>
<section class="projects-list-page py-5 py-lg-6">
    <div class="container">
        <p>
            <a asp-action="AddAddress">Add New Address</a>
        </p>

        <div class="projects-list">
            <table class="table">
            <thead>
                <tr>
                    <th>
                        AddressLine1
                    </th>
                    <th>
                        Zip Code
                    </th>
                    <th></th>
                </tr>
                
            </thead>
            <tbody>
                @if (Model?.Addresses != null && Model.Addresses.Any())
                {
                    foreach (var address in Model.Addresses)
                    {
                         <tr>
                             <td>
                                 @Html.DisplayFor(modelItem => address.AddressLine1)
                             </td>
                             <td>
                                 @Html.DisplayFor(modelItem => address.ZipCode)
                             </td>
                             <td>
                                    <a asp-action="EditAddress" asp-route-id="@address.Id">Edit</a> |
                                    <form asp-action="DeleteAddress"
                                          asp-route-id="@address.Id"
                                          method="post"
                                          style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit">Delete</button>
                                    </form>
                                </td>
                         </tr>
                    }
                }
               
            </tbody>
        </table>
    </div>
</section>