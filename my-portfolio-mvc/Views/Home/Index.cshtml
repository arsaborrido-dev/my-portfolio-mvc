@using my_portfolio_mvc.ViewModels.Home;

@* @inject IConfiguration Configuration *@

@model HomeViewModel

@{
    ViewData["Title"] = "Portfolio";
}

<!-- HERO -->
<section id="home" class="hero">

    <div class="container-fluid p-0">

        <div class="row g-0 min-vh-100">

            <!-- Hero Content -->

            <div class="col-lg-6 d-flex align-items-center">

                <div class="hero-content w-100">

                    <p class="hero-label">
                        Software Developer
                    </p>

                    <h1 class="hero-name">

                        <span class="first-name">
                            Chao <span class="divider">|</span>
                        </span>

                        <span class="last-name">
                            Saborrido
                        </span>

                    </h1>

                    <p class="hero-text">
                        Software developer working with Microsoft technologies, including backend applications,
                        APIs, and data-driven solutions in .NET. I also work with SSIS for ETL processes
                        and SSRS for reporting.
                    </p>

                    <div class="d-flex flex-wrap gap-2">

                        <a asp-controller="Project"
                           asp-action="ProjectsList"
                           class="btn button">

                            View All Projects

                        </a>

                        <a href="#contact"
                           class="btn button button-secondary">

                            Contact Me

                        </a>

                    </div>

                </div>

            </div>

            <!-- Hero Image -->

            <div class="col-lg-6">

                <div class="hero-image"
                     role="img"
                     aria-label="Professional portrait">
                </div>

            </div>

        </div>

    </div>

</section>

<!-- ABOUT -->
<section id="about" class="section about">
    <div class="container">

        <div class="section-header">

            <span class="section-label">
                01 - About
            </span>

            <h1 class="section-title">
                Developing practical applications and data solutions with technology.
            </h1>

        </div>


        <div class="row g-5 align-items-start">

            <!-- About Text -->

            <div class="col-lg-6">

                <div class="about-text">

                    <p>
                        I'm a software developer with experience creating applications,
                        APIs, data integrations, ETL processes, and reporting
                        solutions within the Microsoft ecosystem.
                    </p>

                    <p>
                        My work includes backend development in C#,
                        SQL-based data workflows, SSIS ETL packages,
                        and SSRS reports that support day-to-day
                        business operations.
                    </p>

                    <p>
                        This portfolio highlights projects that reflect my experience
                        across backend development, data-driven applications,
                        and the tools I continue to learn and improve over time.
                    </p>

                    <p>
                        I also share some of my work on YouTube, where I upload short videos about data transformations and ETL concepts.
                        These include practical examples using SSIS components like Lookup, Derived Column, Conditional Split, and more.
                        If you're interested, you can check <a style="font-weight:bold;" href="https://www.youtube.com/channel/UC5K6oEwlKo52FbJASlcVPMA" target="_blank" rel="noopener">my YouTube channel</a>.

                    </p>

                </div>

            </div>


            <!-- About Details -->

            <div class="col-lg-6">

                <div class="row g-3">

                    <div class="col-sm-6">

                        <div class="detail-card h-100">

                            <strong>Focus</strong>

                            <span>
                                Backend & Web Development - Building applications and APIs using .NET
                            </span>

                        </div>

                    </div>

                    <div class="col-sm-6">

                        <div class="detail-card h-100">

                            <strong>Specialty</strong>

                            <span>
                                APIs & Data Integration - Working with SQL Server, SSIS, and ETL processes
                            </span>

                        </div>

                    </div>

                    <div class="col-sm-6">

                        <div class="detail-card h-100">

                            <strong>Approach</strong>

                            <span>
                                Simple, maintainable, and aligned with standard software engineering principles
                            </span>

                        </div>

                    </div>

                    <div class="col-sm-6">

                        <div class="detail-card h-100">

                            <strong>Portfolio</strong>

                            <span>
                                Continually improving and expanding over time
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>

<!-- SKILLS -->
<section id="skills" class="section">
    <div class="container">

        <div class="section-header">

            <span class="section-label">
                02 - Skills
            </span>

            <h2 class="section-title">
                Technologies I work with.
            </h2>

            <p class="section-description">
                I use Microsoft and .NET tools to build applications, APIs, integrations, ETL workflows,
                and reporting solutions.
            </p>
            <p class="section-description">
                I also use GitHub for version control and project organization, along with a simple
                CI/CD workflow that helps me ship updates in a consistent way.
            </p>
        </div>


        @* <div class="row g-3"> *@
        <div class="skills-container row row-cols-2 row-cols-sm-3 row-cols-lg-4 row-cols-xl-5 g-2">

            @if (Model?.Skills != null && Model.Skills.Any())
            {
                foreach (var skill in Model.Skills)
                {
                    @* <div class="col-12 col-sm-6 col-lg-4 col-xl"> *@
                    <div class="skill-wrapper col">

                        <div class="skill-card h-100">

                            @skill.Name

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="loading">
                        No skills available yet.
                    </div>

                </div>
            }

        </div>

        <div class="technologies-container row row-cols-2 row-cols-sm-3 row-cols-lg-4 row-cols-xl-5 g-2">

            @if (Model?.Technologies != null && Model.Technologies.Any())
            {
                foreach (var technology in Model.Technologies)
                {
                    @* <div class="col-12 col-sm-6 col-lg-4 col-xl"> *@
                    <div class="technology-wrapper col">

                        <div class="technology-card h-100">

                            @technology.Name

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="loading">
                        No technologies available yet.
                    </div>

                </div>
            }

        </div>

    </div>

</section>

<!-- FEATURED PROJECTS -->
<section id="featuredprojects" class="section projects">
    <div class="container">

        <div class="section-header">

            <span class="section-label">
                03 - Featured Projects
            </span>

            <h2 class="section-title">
                Selected work.
            </h2>

            <p class="section-description">
                These projects represent the practical applications, integrations, and backend workflows I continue to develop and improve.
            </p>

        </div>

        <div class="row g-4">

            @if (Model?.FeaturedProjects != null && Model.FeaturedProjects.Any())
            {
                for (int i = 0; i < Model.FeaturedProjects.Count; i++)
                {
                    var project = Model.FeaturedProjects[i];

                    <div class="col-12 col-md-6 col-xl-4">

                        <article class="project-card h-100">

                            <span class="project-number">
                                @((i + 1).ToString("D2"))
                            </span>

                            @if (!string.IsNullOrWhiteSpace(
                                project.ThumbnailImageUrl))
                            {
                                <a asp-controller="Project"
                                    asp-action="ProjectDetail"
                                    asp-route-id="@project.Id"
                                    class="text-decoration-none">

                                    <img src="@project.ThumbnailImageUrl"
                                     alt="@project.Title"
                                     class="project-thumb" />

                                </a>

                            }

                            <h3 class="project-card-title">
                                <a asp-controller="Project"
                                    asp-action="ProjectDetail"
                                    asp-route-id="@project.Id"
                                    class="text-decoration-none">

                                    @project.Title

                                </a>
                            </h3>

                            <p class="project-card-title-description">
                                @project.ShortDescription
                            </p>

                            @if (project.Skills != null && project.Skills.Any())
                            {
                                <div class="project-tags">

                                    @foreach (var skill in project.Skills)
                                    {
                                        <span class="tag">
                                            @skill
                                        </span>
                                    }

                                </div>
                            }


                            <div class="project-actions">

                                <a asp-controller="Project"
                                   asp-action="ProjectDetail"
                                   asp-route-id="@project.Id"
                                   class="btn button button-secondary">

                                    View Details

                                </a>

                                <a asp-controller="Project"
                                   asp-action="ProjectsList"
                                   class="view-all-link">

                                    View All Projects

                                </a>

                            </div>

                        </article>

                    </div>
                }
            }
            else
            {
                <div class="col-12">

                    <div class="loading">
                        No projects available yet.
                    </div>

                </div>
            }

        </div>

    </div>

</section>

<!-- CONTACT -->
<section id="contact" class="section">
    <div class="container">

        <div class="section-header mb-4">

            <span class="section-label">
                04 - Contact
            </span>

            <h2 class="section-title">
                Let's connect.
            </h2>

            <p class="section-description">
                For professional inquiries, employment opportunities,
                or to learn more about my work, feel free to connect with me.
            </p>

        </div>

        <ul class="contact-list">

            <li>
                <span>Email</span>
                <a href="mailto:chaosaborrido@gmail.com">
                    chaosaborrido@gmail.com
                </a>
            </li>

            <li>
                <span>LinkedIn</span>
                <a href="https://www.linkedin.com/in/augustus-rosano-saborrido-3a222a61"
                   target="_blank"
                   rel="noopener">
                    LinkedIn Profile
                </a>
            </li>

            <li>
                <span>GitHub</span>
                <a href="https://github.com/arsaborrido-dev"
                   target="_blank"
                   rel="noopener">
                    GitHub Profile
                </a>
            </li>

        </ul>

    </div>
</section>
