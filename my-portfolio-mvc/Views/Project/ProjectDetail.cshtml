@using my_portfolio_mvc.ViewModels.Project;

@model ProjectViewModel

@{
   
    ViewData["Title"] = Model.Title;

    var screenshots = Model.Screenshots
        .Where(x => !string.IsNullOrWhiteSpace(x.ImageUrl))
        .Take(6)
        .ToList();

        
    var mainImageUrl = !string.IsNullOrWhiteSpace(Model.ThumbnailImageUrl)
        ? Model.ThumbnailImageUrl
        : screenshots.FirstOrDefault()?.ImageUrl;
}

<section class="project-detail py-5 py-lg-6">
    <div class="container">

        <!-- =====================================================
         PROJECT HEADER
         ===================================================== -->

        <div class="project-detail-header mb-5">

            @* <a asp-controller="Project"
               asp-action="ProjectsList"
               class="project-back d-inline-flex align-items-center gap-2 text-decoration-none mb-5">

                <span class="project-back-arrow">←</span>

                Back to Projects

            </a> *@
            <a asp-controller="Project"
                asp-action="ProjectsList"
                class="project-back text-decoration-none">
                ← Back to all projects                
            </a>  

            <div class="project-detail-label mb-3">
                Project
            </div>


            <h1 class="project-detail-title mb-4">            
                @Model.Title
            </h1>


            <p class="project-detail-intro mb-0">
                @Model.ShortDescription
            </p>

        </div>


        <!-- =====================================================
             VISUAL WORKSPACE
             ===================================================== -->
        @if (!string.IsNullOrWhiteSpace(mainImageUrl) || screenshots.Any())
        {
            <section class="project-workspace mb-5" aria-label="Project visuals">

                <!-- MAIN IMAGE -->
                <div class="project-stage">

                    @* <div class="project-stage-topline">
                        <span>Primary view</span>
                        <span>Interactive preview</span>
                    </div> *@

                    <div class="project-main-frame">
                        @if (!string.IsNullOrWhiteSpace(mainImageUrl))
                        {
                            <img id="main-project-image"
                                 src="@mainImageUrl"
                                 alt="@Model.Title project screenshot"
                                 loading="eager" />
                        }
                        else
                        {
                            <div class="project-image-empty-v2">
                                No project imagery available
                            </div>
                        }
                    </div>

                    <div class="project-stage-caption">
                        @* <span id="project-stage-caption">Selected frame</span> *@
                        <span>Click a frame to explore</span>
                    </div>

                    <div class="project-detail-technologies">
                        <!-- Technologies -->
                        @* @if (Model.Technologies.Any()) *@
                        @if (Model.Technologies != null && Model.Technologies.Any())               
                        {
                            <section class="project-detail-section">

                                <span class="detail-section-label">
                                    Technologies
                                </span>

                                @* <h2>
                                    Built with
                                </h2> *@
                                <h1 class="project-detail-sub-title mb-4">            
                                    Technologies used
                                </h1>
                                @* <div class="d-flex flex-wrap gap-2"> *@
                                  <div class="row g-4 mb-0">

                                    @foreach (var categoryGroup in Model.Technologies
                                        .Where(t => !string.IsNullOrWhiteSpace(t.TechnologyCategory))
                                        .GroupBy(t => t.TechnologyCategory)
                                        .OrderBy(g => g.Key))
                                    {
                                        <div class="col-md-4">

                                            <div class="project-detail-technology-category mb-1 text-muted">
                                                @categoryGroup.Key
                                            </div>

                                            <ul class="list-unstyled mb-0">
                                                @foreach (var technology in categoryGroup.OrderBy(t => t.Name))
                                                {
                                                    <li>
                                                        <div class="technology-wrapper col">
                                                            <div class="technology-card h-100">
                                                                @technology.Name
                                                            </div>
                                                        </div>

                                                    </li>
                                                }
                                            </ul>

                                        </div>
                                    }

                                </div>



                            </section>
                        }
                    </div>

                </div>

                <!-- SCREENSHOT BROWSER -->
                <aside class="project-frame-browser" aria-label="Project screenshots">
                   
                    @if (screenshots.Any())
                    {
                        <div class="project-frame-list">
                            @for (var i = 0; i < screenshots.Count; i++)
                            {
                                var screenshot = screenshots[i];

                                <button type="button"
                                        class="project-frame-button @(i == 0 ? "active" : "")"
                                        data-project-image="@screenshot.ImageUrl"
                                        data-project-title="@Model.Title"
                                        data-frame-number="@(i + 1)"
                                        aria-label="View project screenshot @(i + 1)"
                                        aria-pressed="@(i == 0 ? "true" : "false")">

                                    <span class="frame-number">
                                        @((i + 1).ToString("00"))
                                    </span>

                                    <span class="frame-image">
                                        <img src="@screenshot.ImageUrl"
                                             alt="@Model.Title screenshot @(i + 1)"
                                             loading="lazy" />
                                    </span>

                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="frame-browser-empty">
                            No additional frames.
                        </div>
                    }

                </aside>

            </section>
        }


        <!-- =====================================================
         PROJECT CONTENT
         ===================================================== -->

        <div class="row g-5 g-xl-6 align-items-start">

            <!-- =================================================
             MAIN CONTENT
             ================================================= -->

            <main class="col-lg-8 project-detail-main">

                <!-- Overview -->

                <section class="project-detail-section">

                    <span class="detail-section-label">
                        Overview
                    </span>

                    @* <h4>
                        About this project
                    </h4> *@

                    <h1 class="project-detail-sub-title mb-4">            
                        About this project
                    </h1>

                    <p>
                        @Html.Raw(Model.LongDescription)
                        @* @Model.LongDescription *@
                    </p>

                @* </section> *@

               @*  <section class="project-detail-section">      *@               
                   
                    <div class="mt-4">
                        <h1 class="project-detail-sub-title mb-4">            
                            What This Project Demonstrates
                        </h1>

                        <p>
                            @Html.Raw(Model.ProjectDemonstration)
                            @* @Model.LongDescription *@
                        </p>
                    </div>
                </section>
                <!-- Skills -->
                @* @if (Model.Skills.Any()) *@
                @* @if (Model.Skills != null && Model.Skills.Any())                
                {
                    <section class="project-detail-section">

                        <span class="detail-section-label">
                            Skills
                        </span>

                        <h2>
                            What this project demonstrates
                        </h2>

                        <div class="d-grid gap-2">

                            @foreach (var skill in Model.Skills)
                            {
                                <div class="project-skill">

                                    <span class="project-skill-marker"></span>

                                    <span>
                                        @skill.Name
                                    </span>

                                </div>
                            }

                        </div>

                    </section>
                } *@

            </main>


            <!-- =================================================
             PROJECT INFORMATION SIDEBAR
             ================================================= -->

            <aside class="col-lg-4">

                <div class="project-detail-sidebar">

                    <div class="project-info-card">

                        <!-- Project -->

                        <div class="project-info-item">

                            <span>
                                Project
                            </span>

                            <strong>
                                @Model.Title
                            </strong>

                        </div>


                        <!-- Created -->
                        @if (Model.CreatedAtUtc != default)
                        {
                            <div class="project-info-item">

                                <span>
                                    Created
                                </span>

                                <strong>
                                    @Model.CreatedAtUtc.ToString("MMMM yyyy")
                                </strong>

                            </div>
                        }


                        <!-- Technologies Count -->
                        @if (Model.Technologies != null &&
                                                 Model.Technologies.Any())
                        {
                            <div class="project-info-item">

                                <span>
                                    Technologies
                                </span>

                                <strong>
                                    @Model.Technologies.Count
                                </strong>

                            </div>
                        }


                        <!-- Skills Count -->
                        @if (Model.Skills != null &&
                                                 Model.Skills.Any())
                        {
                            <div class="project-info-item">

                                <span>
                                    Skills
                                </span>

                                <strong>
                                    @Model.Skills.Count
                                </strong>

                            </div>
                        }


                        <!-- Screenshots Count -->
                        @if (screenshots.Any())
                        {
                            <div class="project-info-item">

                                <span>
                                    Screenshots
                                </span>

                                <strong>
                                    @screenshots.Count
                                </strong>

                            </div>
                        }


                        <!-- Links -->
                        @if (!string.IsNullOrWhiteSpace(Model.GithubUrl) ||
                                                 !string.IsNullOrWhiteSpace(Model.LiveDemoUrl))
                        {
                            <div class="project-info-actions">

                                @if (!string.IsNullOrWhiteSpace(Model.GithubUrl))
                                {
                                    <a href="@Model.GithubUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn button project-link-button">

                                        GitHub

                                        @* <span>↗</span> *@

                                    </a>
                                }

                                <div class="input-group">
                                    <a href="@Model?.LiveDemoUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="btn btn-teal px-4">

                                        Proof

                                        @* <span>↗</span> *@

                                    </a>
                                    <input type="text"
                                           id="proof-value"
                                           class="form-control border-secondary-subtle shadow-none"
                                           value="@Model?.LiveDemoUrl"
                                           placeholder="Project url..."
                                           disabled />                                   
                                </div>

                            </div>
                        }

                    </div>

                </div>

            </aside>

        </div>


        <!-- =====================================================
         PROJECT FOOTER NAVIGATION
         ===================================================== -->

        <div class="project-detail-footer">

            @* <a asp-controller="Project"
               asp-action="ProjectsList"
               class="project-back">

                <span class="project-back-arrow">
                    ←
                </span>

                Back to all projects

            </a> *@
            <a asp-controller="Project"
                asp-action="ProjectsList"
                class="project-back text-decoration-none">
                ← Back to all projects                
            </a>
        </div>

    </div>

</section>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const mainImage = document.getElementById("main-project-image");
            const screenshotButtons =
                document.querySelectorAll(".project-frame-button");
            const stageCaption =
                document.getElementById("project-stage-caption");

            if (!mainImage || !screenshotButtons.length) {
                return;
            }

            screenshotButtons.forEach(function (button) {

                button.addEventListener("click", function () {

                    const imageUrl =
                        button.getAttribute("data-project-image");

                    const projectTitle =
                        button.getAttribute("data-project-title");

                    const frameNumber =
                        button.getAttribute("data-frame-number");

                    if (!imageUrl) {
                        return;
                    }

                    mainImage.style.opacity = "0";

                    window.setTimeout(function () {
                        mainImage.src = imageUrl;

                        if (projectTitle) {
                            mainImage.alt =
                                projectTitle +
                                " project screenshot " +
                                (frameNumber || "");
                        }

                        mainImage.style.opacity = "1";
                    }, 120);


                    screenshotButtons.forEach(function (item) {
                        item.classList.remove("active");
                        item.setAttribute("aria-pressed", "false");
                    });

                    button.classList.add("active");
                    button.setAttribute("aria-pressed", "true");

                    // if (stageCaption && frameNumber) {
                    //     stageCaption.textContent =
                    //         "Selected frame " +
                    //         frameNumber.padStart(2, "0");
                    // }
                });

            });

        });
    </script>

}