@using my_portfolio_mvc.ViewModels.Project;
@using my_portfolio_mvc.Security;

@model ProjectsListViewModel

@{
    ViewData["Title"] = "Projects";
}

<section class="projects-list-page py-5 py-lg-6">
    <div class="container">

        <header class="projects-list-header">
                        
            <a asp-controller="Home"
                asp-action="Index"
                asp-fragment="home"
                class="project-back text-decoration-none">
                ← Back to portfolio                
            </a>            

            <div class="project-detail-label">
                Projects
            </div>

            <h1 class="project-detail-title">
                Selected work.
            </h1>

            <p class="project-detail-intro">
                A collection of projects and technical solutions I've built.
            </p>

        </header>
        

        <div class="projects-list-toolbar d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-4">

            <form method="get"
                  asp-action="ProjectsList"
                  class="projects-search flex-grow-1">

                <div class="projects-search-wrapper input-group">

                    <input type="text"
                           id="project-search"
                           name="search"
                           value="@Model?.Search"
                           placeholder="Search by project name..."
                           class="projects-search-input form-control"
                           autocomplete="off" />

                    <button type="submit"
                            class="projects-search-button btn button">
                        Search
                    </button>

                </div>

            </form>

            @if (Model != null && Model.TotalPages > 1)
            {
                <nav class="projects-pagination projects-pagination-top"
                     aria-label="Projects pagination">

                    <div class="projects-pagination-inner">

                        @if (Model.PageNumber > 1)
                        {
                            <a asp-action="ProjectsList"
                               asp-route-page="@(Model.PageNumber - 1)"
                               asp-route-search="@Model.Search"
                               class="projects-pagination-button">

                                ← Previous

                            </a>
                        }
                        else
                        {
                            <span class="projects-pagination-button disabled">
                                ← Previous
                            </span>
                        }

                        <div class="projects-pagination-pages">

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                if (i == Model.PageNumber)
                                {
                                    <span class="projects-pagination-page active"
                                          aria-current="page">
                                        @i
                                    </span>
                                }
                                else
                                {
                                    <a asp-action="ProjectsList"
                                       asp-route-page="@i"
                                       asp-route-search="@Model.Search"
                                       class="projects-pagination-page">
                                        @i
                                    </a>
                                }
                            }

                        </div>

                        @if (Model.PageNumber < Model.TotalPages)
                        {
                            <a asp-action="ProjectsList"
                               asp-route-page="@(Model.PageNumber + 1)"
                               asp-route-search="@Model.Search"
                               class="projects-pagination-button">

                                Next →

                            </a>
                        }
                        else
                        {
                            <span class="projects-pagination-button disabled">
                                Next →
                            </span>
                        }

                    </div>

                </nav>
            }

        </div>

        @if (Model != null && Model.ProjectViewModels.Any())
        {
            <div class="projects-list">

                @* <div class="projects-list-header-row row g-3 d-none d-lg-flex"> *@
            @*     <div class="projects-list-header-row row g-3 g-lg-3 d-none d-lg-flex">

                    <div class="col-md-2">Preview</div>
                    <div class="col-md-2">Project</div>
                    <div class="col-md-5">Description</div>
                    <div class="col-md-3">Links</div>

                </div> *@
                <div class="projects-list-header-row row g-3 g-lg-3 d-none d-lg-flex">

                    <div class="col-md-2">Preview</div>
                    <div class="col-md-2">Project</div>
                    <div class="col-md-5">Description</div>
                    <div class="col-md-3">Links</div>

                </div>

                @foreach (var project in Model.ProjectViewModels)
                {
                    <article class="project-list-row row g-3 g-lg-3 align-items-center ml-2">
                       
                        <div class="project-list-thumbnail col-md-2 ml-2">

                            <a asp-controller="Project"
                               asp-action="ProjectDetail"
                               asp-route-id="@project.Id"
                               class="project-thumbnail-link"
                               aria-label="View @project.Title">

                                @if (!string.IsNullOrWhiteSpace(project.ThumbnailImageUrl))
                                {
                                    <img src="@project.ThumbnailImageUrl"
                                         alt="@project.Title"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="project-thumbnail-placeholder">
                                        No Image
                                    </div>
                                }

                            </a>

                        </div>

                        <div class="project-list-title col-md-2">

                            <a asp-controller="Project"
                               asp-action="ProjectDetail"
                               asp-route-id="@project.Id"
                               class="text-decoration-none">

                                @project.Title

                            </a>

                        </div>

                        <div class="project-list-description col-md-5">

                            <p>
                                @HtmlSanitizerHelper.Sanitize(project.ShortDescription)
                            </p>

                        </div>

                        <div class="project-list-links col-md-3">

                            @if (!string.IsNullOrWhiteSpace(project.GithubUrl))
                            {
                                <a href="@project.GithubUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="project-list-link text-decoration-none">

                                    GitHub
                                    @* <span>↗</span> *@

                                </a>
                            }

                            @if (!string.IsNullOrWhiteSpace(project.LiveDemoUrl))
                            {
                                <a href="@project.LiveDemoUrl"
                                   target="_blank"
                                   rel="noopener noreferrer"
                                   class="project-list-link text-decoration-none">

                                    Live Demo
                                    @* <span>↗</span> *@

                                </a>
                            }

                            @if (string.IsNullOrWhiteSpace(project.GithubUrl) &&
                                 string.IsNullOrWhiteSpace(project.LiveDemoUrl))
                            {
                                <span class="project-list-no-link">
                                    —
                                </span>
                            }

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="projects-list-empty">

                <p>
                    No projects available yet.
                </p>

            </div>
        }

        @if (Model != null && Model.TotalPages > 1)
        {
            <nav class="projects-pagination projects-pagination-bottom"
                 aria-label="Projects pagination">

                <div class="projects-pagination-inner">

                    @if (Model.PageNumber > 1)
                    {
                        <a asp-action="ProjectsList"
                           asp-route-page="@(Model.PageNumber - 1)"
                           asp-route-search="@Model.Search"
                           class="projects-pagination-button">

                            ← Previous

                        </a>
                    }
                    else
                    {
                        <span class="projects-pagination-button disabled">
                            ← Previous
                        </span>
                    }

                    <div class="projects-pagination-pages">

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            if (i == Model.PageNumber)
                            {
                                <span class="projects-pagination-page active"
                                      aria-current="page">
                                    @i
                                </span>
                            }
                            else
                            {
                                <a asp-action="ProjectsList"
                                   asp-route-page="@i"
                                   asp-route-search="@Model.Search"
                                   class="projects-pagination-page">
                                    @i
                                </a>
                            }
                        }

                    </div>

                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <a asp-action="ProjectsList"
                           asp-route-page="@(Model.PageNumber + 1)"
                           asp-route-search="@Model.Search"
                           class="projects-pagination-button">

                            Next →

                        </a>
                    }
                    else
                    {
                        <span class="projects-pagination-button disabled">
                            Next →
                        </span>
                    }

                </div>

            </nav>
        }

        <div class="privacy-footer">

            <a asp-controller="Home"
                asp-action="Index"
                class="privacy-back">
                ← Back to portfolio
            </a>

        </div>            

    </div>
</section>
