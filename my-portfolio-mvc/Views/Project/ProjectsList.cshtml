@using my_portfolio_mvc.ViewModels.Project;

@model ProjectsListViewModel

@{
    ViewData["Title"] = "Projects";
}

<section class="py-5 py-lg-6 bg-light">
    <div class="container">

        <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

        <div class="mb-5">

            <a asp-controller="Home"
               asp-action="Index"
               asp-fragment="home"
               class="d-inline-flex align-items-center gap-2 text-secondary text-decoration-none small fw-semibold mb-5 project-back">

                <span class="text-teal fs-5">←</span>
                Back to Portfolio

            </a>

            <div class="text-uppercase text-teal fw-bold small letter-spacing-wide mb-3">
                Projects
            </div>

            <h1 class="display-3 fw-normal text-navy mb-4">
                Selected work.
            </h1>

            <p class="lead text-secondary mb-0" style="max-width: 700px;">
                A collection of projects and technical solutions I've built.
            </p>

        </div>


        <!-- =====================================================
         TOOLBAR
         ===================================================== -->

        <div class="row align-items-center g-3 mb-4">

            <!-- Search -->

            <div class="col-12 col-lg">

                <form method="get"
                      asp-action="ProjectsList"
                      class="d-flex">

                    <div class="input-group">

                        <input type="text"
                               id="project-search"
                               name="search"
                               value="@Model?.Search"
                               placeholder="Search by project name..."
                               class="form-control border-secondary-subtle shadow-none"
                               autocomplete="off" />

                        <button type="submit"
                                class="btn btn-teal px-4">

                            Search

                        </button>

                    </div>

                </form>

            </div>


            <!-- Top Pagination -->
            @if (Model != null && Model.TotalPages > 1)
            {
                <div class="col-12 col-lg-auto">

                    <nav aria-label="Projects pagination">

                        <ul class="pagination mb-0 justify-content-lg-end">

                            @if (Model.PageNumber > 1)
                            {
                                <li class="page-item">

                                    <a asp-action="ProjectsList"
                                       asp-route-page="@(Model.PageNumber - 1)"
                                       asp-route-search="@Model.Search"
                                       class="page-link">

                                        ← Previous

                                    </a>

                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">

                                    <span class="page-link">
                                        ← Previous
                                    </span>

                                </li>
                            }


                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                if (i == Model.PageNumber)
                                {
                                    <li class="page-item active"
                                        aria-current="page">

                                        <span class="page-link">
                                            @i
                                        </span>

                                    </li>
                                }
                                else
                                {
                                    <li class="page-item">

                                        <a asp-action="ProjectsList"
                                           asp-route-page="@i"
                                           asp-route-search="@Model.Search"
                                           class="page-link">

                                            @i

                                        </a>

                                    </li>
                                }
                            }


                            @if (Model.PageNumber < Model.TotalPages)
                            {
                                <li class="page-item">

                                    <a asp-action="ProjectsList"
                                       asp-route-page="@(Model.PageNumber + 1)"
                                       asp-route-search="@Model.Search"
                                       class="page-link">

                                        Next →

                                    </a>

                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">

                                    <span class="page-link">
                                        Next →
                                    </span>

                                </li>
                            }

                        </ul>

                    </nav>

                </div>
            }

        </div>


        <!-- =====================================================
         PROJECT LIST
         ===================================================== -->
        @if (Model != null && Model.ProjectViewModels.Any())
        {
            <div class="border-top border-secondary-subtle">

                <!-- Desktop List Header -->

                <div class="row d-none d-lg-grid py-3 px-3 border-bottom border-secondary-subtle text-uppercase small fw-bold text-secondary"
                     style="grid-template-columns: 150px minmax(180px, .8fr) minmax(280px, 1.5fr) 150px; gap: 28px;">

                    <div style="text-align: left;">
                        Preview
                    </div>

                    <div style="text-align: left;">
                        Project
                    </div>

                    <div style="text-align: left;">
                        Description
                    </div>

                    <div style="text-align: left;">
                        Links
                    </div>

                </div>


                <!-- Projects -->
                @foreach (var project in Model.ProjectViewModels)
                {
                    <article class="row g-3 g-lg-4 align-items-start p-3 p-lg-4 border-bottom border-secondary-subtle project-list-item">

                        <!-- =================================================
                         THUMBNAIL
                         ================================================= -->

                        <div class="col-5 col-sm-4 col-lg-auto"
                             style="width: 150px;">

                            <a asp-controller="Project"
                               asp-action="ProjectDetail"
                               asp-route-id="@project.Id"
                               class="d-block text-decoration-none">

                                <div class="ratio ratio-4x3 overflow-hidden rounded border border-secondary-subtle bg-body-secondary project-thumbnail">

                                    @if (!string.IsNullOrWhiteSpace(project.ThumbnailImageUrl))
                                    {
                                        <img src="@project.ThumbnailImageUrl"
                                             alt="@project.Title"
                                             loading="lazy"
                                             class="w-100 h-100 object-fit-cover" />
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center justify-content-center bg-teal-light text-secondary text-uppercase small fw-semibold">
                                            No Image
                                        </div>
                                    }

                                </div>

                            </a>

                        </div>


                        <!-- =================================================
                         TITLE
                         ================================================= -->

                        <div class="col-7 col-sm-8 col-lg"
                             style="min-width: 180px; text-align: left;">

                            <a asp-controller="Project"
                               asp-action="ProjectDetail"
                               asp-route-id="@project.Id"
                               class="project-title text-navy text-decoration-none fw-semibold">

                                @project.Title

                            </a>

                        </div>


                        <!-- =================================================
                         DESCRIPTION
                         ================================================= -->

                        <div class="col-12 col-lg"
                             style="min-width: 280px; text-align: left;">

                            <p class="mb-0 text-secondary lh-lg">

                                @project.ShortDescription

                            </p>

                        </div>


                        <!-- =================================================
                         LINKS
                         ================================================= -->

                        <div class="col-12 col-lg-auto"
                             style="width: 150px; text-align: left;">

                            <div class="d-flex flex-row flex-lg-column gap-2 align-items-start">

                                @if (!string.IsNullOrWhiteSpace(project.GithubUrl))
                                {
                                    <a href="@project.GithubUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="project-list-link text-navy text-decoration-none small fw-semibold">

                                        GitHub
                                        <span class="text-teal">↗</span>

                                    </a>
                                }

                                @if (!string.IsNullOrWhiteSpace(project.LiveDemoUrl))
                                {
                                    <a href="@project.LiveDemoUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="project-list-link text-navy text-decoration-none small fw-semibold">

                                        Live Demo
                                        <span class="text-teal">↗</span>

                                    </a>
                                }

                                @if (string.IsNullOrWhiteSpace(project.GithubUrl) &&
                                     string.IsNullOrWhiteSpace(project.LiveDemoUrl))
                                {
                                    <span class="text-secondary small">
                                        —
                                    </span>
                                }

                            </div>

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="card border border-secondary-subtle rounded-4 shadow-sm text-center p-5">

                <p class="mb-0 text-secondary">
                    No projects available yet.
                </p>

            </div>
        }


        <!-- =====================================================
         BOTTOM PAGINATION
         ===================================================== -->
        @if (Model != null && Model.TotalPages > 1)
        {
            <nav aria-label="Projects pagination"
                 class="d-flex justify-content-end mt-4">

                <ul class="pagination mb-0">

                    @if (Model.PageNumber > 1)
                    {
                        <li class="page-item">

                            <a asp-action="ProjectsList"
                               asp-route-page="@(Model.PageNumber - 1)"
                               asp-route-search="@Model.Search"
                               class="page-link">

                                ← Previous

                            </a>

                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">

                            <span class="page-link">
                                ← Previous
                            </span>

                        </li>
                    }


                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.PageNumber)
                        {
                            <li class="page-item active"
                                aria-current="page">

                                <span class="page-link">
                                    @i
                                </span>

                            </li>
                        }
                        else
                        {
                            <li class="page-item">

                                <a asp-action="ProjectsList"
                                   asp-route-page="@i"
                                   asp-route-search="@Model.Search"
                                   class="page-link">

                                    @i

                                </a>

                            </li>
                        }
                    }


                    @if (Model.PageNumber < Model.TotalPages)
                    {
                        <li class="page-item">

                            <a asp-action="ProjectsList"
                               asp-route-page="@(Model.PageNumber + 1)"
                               asp-route-search="@Model.Search"
                               class="page-link">

                                Next →

                            </a>

                        </li>
                    }
                    else
                    {
                        <li class="page-item disabled">

                            <span class="page-link">
                                Next →
                            </span>

                        </li>
                    }

                </ul>

            </nav>
        }

    </div>

</section>