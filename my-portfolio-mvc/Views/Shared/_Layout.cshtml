<!DOCTYPE html> <html lang="en"> <head> <meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>@ViewData["Title"] - Chao | Saborrido</title>

<meta name="description"
      content="Portfolio website for Chao | Saborrido — software developer specializing in C#, SSIS, SSRS, APIs, and ASP.NET." />

<!-- Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous" />

<!-- Site styles -->
<link rel="stylesheet"
      href="~/css/site.css"
      asp-append-version="true" />

</head> <body>
<!-- =========================================================
     SHARED HEADER / NAVIGATION
     ========================================================= -->

<header class="site-header sticky-top">

    <nav class="navbar navbar-expand-lg">

        <div class="container">

            @* <a asp-controller="Home"
               asp-action="Index"
               class="navbar-brand logo"
               aria-label="Chao Saborrido home">

                <span class="logo-first">Chao</span>
                <span class="logo-divider">|</span>
                <span class="logo-last">Saborrido</span>            

            </a> *@

            <a asp-controller="Home"
               asp-action="Index"
               class="navbar-brand logo d-flex flex-column"
               aria-label="Chao Saborrido home">

                <div>
                    <span class="logo-first">Chao</span>
                    <span class="logo-divider">|</span>
                    <span class="logo-last">Saborrido</span>
                </div>

            </a>
            
            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavigation"
                    aria-controls="mainNavigation"
                    aria-expanded="false"
                    aria-label="Toggle navigation">

                <span class="navbar-toggler-icon"></span>

            </button>

            @* <div class="collapse navbar-collapse" id="mainNavigation">

                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-4">

                    <li class="nav-item">
                        <a asp-controller="Home"
                           asp-action="Index"
                           asp-fragment="about"
                           class="nav-link">
                            About
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Home"
                           asp-action="Index"
                           asp-fragment="skills"
                           class="nav-link">
                            Skills
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Home"
                           asp-action="Index"
                           asp-fragment="featuredprojects"
                           class="nav-link">
                            Featured Projects
                        </a>
                    </li>

                    <li class="nav-item">
                        <a asp-controller="Home"
                           asp-action="Index"
                           asp-fragment="contact"
                           class="nav-link">
                            Contact
                        </a>
                    </li>

                </ul>
                <small class="text-muted" style="font-size: 0.65rem; line-height: 1; text-align: right;">
                    Built with ASP.NET Core MVC.
                </small>
            </div> *@

            <div class="collapse navbar-collapse" id="mainNavigation">

                <div class="d-flex flex-column align-items-end ms-auto">

                    <ul class="navbar-nav align-items-lg-center gap-lg-4">
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" asp-fragment="about" class="nav-link">
                                About
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" asp-fragment="skills" class="nav-link">
                                Skills
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" asp-fragment="featuredprojects" class="nav-link">
                                Featured Projects
                            </a>
                        </li>
                        <li class="nav-item">
                            <a asp-controller="Home" asp-action="Index" asp-fragment="contact" class="nav-link">
                                Contact
                            </a>
                        </li>
                    </ul>

                    <small style="font-size: 0.65rem; color: silver;">
                        Built with ASP.NET Core MVC.
                    </small>

                </div>

            </div>

        </div>

    </nav>
   
</header>
 

<!-- =========================================================
     PAGE CONTENT
     ========================================================= -->

<main>
    @RenderBody()
</main>


<!-- =========================================================
     SHARED FOOTER
     ========================================================= -->

<footer>

    <div class="container">

        <div class="footer-content">

            <p class="mb-0">
                ©
                <span id="current-year"></span>

                <span class="footer-name">
                    Chao | Saborrido
                </span>.

                All rights reserved.
            </p>

            <p class="mb-0">
                <a asp-controller="Home"
                   asp-action="Privacy"
                   class="footer-privacy">
                    Privacy Policy
                </a>
                <span class="footer-separator">|</span>
                Built with ASP.NET Core MVC.
            </p>

        </div>

    </div>

</footer>


<!-- Bootstrap -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>

<!-- Site JavaScript -->
<script src="~/js/site.js"
        asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body> </html>