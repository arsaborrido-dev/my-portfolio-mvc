    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>my_portfolio_mvc</RootNamespace>
    <UserSecretsId>5368387f-c3e6-4dff-a88e-51a81583b89b</UserSecretsId>
